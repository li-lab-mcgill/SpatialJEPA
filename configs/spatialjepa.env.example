# Copy to configs/spatialjepa.env and edit. Read by spatialjepa/paths.py (Python) and reproduce.sh (shell).
# KEY=VALUE per line; ~ and $VARS are expanded.

# Root holding data/ and outputs/ (the Zenodo deposit unpacks into this layout; see docs/DATA.md).
SPATIALJEPA_HOME=/path/to/spatialjepa_home

# Interpreters of the environments in envs/ (conda env create -f envs/<name>.yml).
PY_MSI=~/miniconda3/envs/spatialjepa-msi/bin/python
PY_ANALYSIS=~/miniconda3/envs/spatialjepa-analysis/bin/python
PY_SCVI=~/miniconda3/envs/spatialjepa-scvi/bin/python
PY_MULTIGRATE=~/miniconda3/envs/spatialjepa-multigrate/bin/python
PY_MOTIF=~/miniconda3/envs/spatialjepa-motifs/bin/python

# Optional
# SPATIALJEPA_MANUSCRIPT=$SPATIALJEPA_HOME/outputs/manuscript      # stand-in for the manuscript project
# SPATIALJEPA_BEDTOOLS_BIN=~/miniconda3/envs/spatialjepa-analysis/bin
# MLFLOW_TRACKING_URI=sqlite:////path/to/mlflow.db                  # RNA-ATAC training only (rna_atac/train_rna_atac.py)
